# 复制本文件为 .env 并填写真实值；.env 已被 .gitignore 忽略，不会入库
# 本地开发与 Docker 部署共用本文件；标注「Docker」的项只对 Docker 部署生效
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=task_system
DATABASE_URL=

# 务必修改！生成方式：openssl rand -hex 32（生产/Docker 部署同样重要，勿留空）
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 容器时区（仅 Docker 部署需要）：datetime.now() 以此为基准，直接影响
# 「计划执行时间」的到期判断与界面时间展示。默认北京时间；
# 服务器在海外可改为其他时区（如 America/New_York），改后需 docker compose up -d 重建。
TZ=Asia/Shanghai

# Docker 部署时宿主机对外访问端口（容器内固定 8000，无需改）；
# 想用 8070 等端口就改这里，然后 docker compose up -d 重建生效。
HOST_PORT=8000

# Docker 部署时 MySQL root 密码（不设则用默认值 changeme_root，仅适合本机测试）
MYSQL_ROOT_PASSWORD=

# Docker 构建换源（国内服务器首次构建慢时配置；留空则用官方源）
# 腾讯云：mirrors.tencent.com / https://mirrors.cloud.tencent.com/pypi/simple / https://mirrors.cloud.tencent.com/npm/
# 阿里云：mirrors.aliyun.com / https://mirrors.cloud.aliyuncs.com/pypi/simple / https://registry.npmmirror.com
APT_MIRROR=
PIP_INDEX_URL=
NPM_REGISTRY=

# ---------------- 邮件提醒（SMTP）----------------
# 推荐 Resend（免费 3000 封/月，选型对比见 README「邮件服务商选择」章节）。
# 收件邮箱由用户在「个人中心」单独填写，可与发件账号是同一个邮箱（发给自己）。
# 端口：SSL 常用 465，STARTTLS 常用 587；对应把 SMTP_USE_SSL 设为 true / false。
# 重要：用自有域名发件时，请在该域名的 DNS 配置 SPF / DKIM / DMARC，
# 否则邮件极可能被收件方判为垃圾邮件（详见 README「邮件提醒」章节）。
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
# 两类服务商填法不同（默认值按 Resend 给出，换服务商时改这里）：
#   事务中继类（Resend 等）：SMTP_USER 固定填字面量 resend，密码填 API Key，
#     并用 SMTP_FROM_ADDRESS 指定验证域名下的发件地址（如 noreply@你的域名）；
#   域名邮箱/企业邮箱类（Zoho、阿里云邮件推送"From=登录名"式）：SMTP_USER 填域名邮箱本身，
#     SMTP_FROM_ADDRESS 留空即可。
SMTP_USER=resend
SMTP_PASSWORD=
# 发件人显示地址（From），须为你已验证归属的域名下的地址；留空则回退用 SMTP_USER。
SMTP_FROM_ADDRESS=noreply@example.com
SMTP_FROM_NAME=任务管理系统
SMTP_USE_SSL=true

# 提醒邮件正文里指向的前端地址（用户点开查看任务用）
# 本地开发默认 5173；Docker 部署务必改成 http://localhost:8000
# （设了 HOST_PORT 则换成对应端口；有域名则用域名），否则邮件里的链接打不开。
FRONTEND_URL=http://localhost:5173
# 后台定时扫描间隔（秒），默认 60
REMINDER_INTERVAL_SECONDS=60
# 是否启用 FastAPI 内置后台定时任务；多 worker 部署时设为 false，改用 scripts/send_reminders.py 调度
ENABLE_REMINDER_WORKER=true
